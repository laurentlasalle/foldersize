msgid "Service status:"
msgstr ""

#. Button. & marks the access key.
msgctxt "service.start"
msgid "&Start"
msgstr "Starten"

#. Button. & marks the access key.
msgctxt "service.stop"
msgid "S&top"
msgstr "Stoppen"

#. Button. & marks the access key.
msgctxt "service.pause"
msgid "&Pause"
msgstr "Onderbreken"

#. Button. & marks the access key.
msgctxt "service.resume"
msgid "&Resume"
msgstr "Doorgaan"

msgctxt "service.admin_note"
msgid "You must have Administrator privileges to modify the service."
msgstr "Je hebt administrator rechten nodig om de status van een service te wijzigen."

msgctxt "service.start_info"
msgid "While the service is running, a Folder Size cache is in memory and monitoring your folders."
msgstr "Wanneer Folder Size gestart is wordt een cache in het geheugen opgebouwd en zal de service uw systeem monitoren en de gegevens in de Windows Verkenner tonen."

msgctxt "service.stop_info"
msgid "When the service is stopped, folder size information is not available in Explorer."
msgstr "Wanneer Folder Size gestopt is, wordt de Folder Size informatie in de Windows Verkenner niet meer getoond."

msgctxt "service.pause_info"
msgid "Pause the background scanning to free disk bandwidth."
msgstr "Het onderbreken van Folder Size stopt het monitoren van uw systeem. De Folder Size gegevens blijven zichtbaar in de Windows Verkenner maar worden niet meer bijgewerkt."

msgctxt "service.resume_info"
msgid "Resume to keep the cache updated."
msgstr "De Folder Size service hervatten zorgt ervoor dat de cache opnieuw vernieuwd wordt zodat de gegevens in de Windows Verkenner bijgewerkt worden."

