msgstr "Licensz"

#. Link.
msgctxt "about.gpl"
msgid "Folder Size for Windows may be distributed under the terms of the GNU General Public License."
msgstr "Folder Size for Windows a GNU General Public License feltételek alatt terjeszthető."

#. Link.
msgctxt "about.gnu"
msgid "Find out more about GNU here."
msgstr "Fedezzen fel még többet a GNU-ról itt."

#. Title of the Credits window.
msgctxt "credits.title"
msgid "Credits"
msgstr ""

msgctxt "credits.intro"
msgid "The following people have all contributed some of their knowledge or expertise to improve Folder Size!"
msgstr "A következő emberek mind közreműködtek a tudásuk szerint vagy szakvéleményükkel abban, hogy fejlesszék a Folder Size-t!"

msgctxt "credits.translation"
msgid "Translation"
msgstr "Fordítás"

msgctxt "credits.graphic"
msgid "Graphic"
msgstr "Grafika"

msgctxt "credits.code"
msgid "Code"
msgstr "Kód"

#. Button.
msgctxt "common.ok"
msgid "OK"
msgstr "OK"

