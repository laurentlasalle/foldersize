# Normalize text files to LF in the repository; Git converts them on checkout.
* text=auto

# Windows-only formats that must keep CRLF line endings on every platform.
*.sln  text eol=crlf
*.vcxproj text eol=crlf
*.props text eol=crlf
*.bat  text eol=crlf
*.rc   text eol=crlf
# Installer tables imported by msidb.exe
*.idt  text eol=crlf

# Binary files
*.ico  binary
*.bmp  binary
*.ibd  binary
*.exe  binary
*.Exe  binary
